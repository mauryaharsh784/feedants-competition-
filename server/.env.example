# Server
PORT=4000
NODE_ENV=development

# MongoDB
# Local example:  mongodb://127.0.0.1:27017/feedants_competition
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>/feedants_competition
MONGO_URI=mongodb://127.0.0.1:27017/feedants_competition

# CORS - comma separated list of allowed origins (use * for the assignment demo)
CORS_ORIGIN=*
